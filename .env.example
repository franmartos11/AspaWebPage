# Formulario de contacto (/api/contacto): se envía con nodemailer por Gmail, como en el sitio anterior.
# EMAIL_PASS es una "contraseña de aplicación" de Google (cuenta con verificación en dos pasos), no la contraseña normal.
EMAIL_USER=
EMAIL_PASS=
