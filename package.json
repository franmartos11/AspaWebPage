{
  "name": "aspa-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "lhci": "npm run build && lhci autorun",
    "check": "npm run lint && tsc --noEmit && npm run test:e2e",
    "test:e2e:engines": "ENGINES=1 playwright test tests/steps.spec.ts --project webkit-1440 --project firefox-1440"
  },
  "dependencies": {
    "lenis": "^1.1.13",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.160.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "typescript": "^5"
  }
}
